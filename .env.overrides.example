#################################################################################
#  OVERRIDES for Environment Variables 
#
#  Purpose: Used for non-standard node configurations such as
#           failover staking nodes or standalone validator client only installs
#      Why: Enables ethpillar scripts to function properly
#################################################################################

#To use, uncomment the hashtag variable and modify the value

#EL_RPC_PORT=8545
#EL_IP_ADDRESS=192.168.1.123
#CL_REST_PORT=5052
#CL_IP_ADDRESS=192.168.1.123

# Obol Charon (DVT middleware)
# Canonical name is CHARON_P2P_PORT. CHARON_PORT_P2P_TCP is accepted as a CDVN alias.
#CHARON_P2P_PORT=3610
#CHARON_PORT_P2P_TCP=3610
#CHARON_VALIDATOR_API_PORT=3600
#CHARON_MONITORING_PORT=3620
#CHARON_P2P_EXTERNAL_IP=203.0.113.10

# SSV Operator
#SSV_P2P_TCP_PORT=13001
#SSV_P2P_UDP_PORT=12001
#SSV_METRICS_PORT=15000
#SSV_API_PORT=16000
#SSV_DKG_PORT=3030
#SSV_P2P_EXTERNAL_IP=203.0.113.10
#SSV_OPERATOR_ID=123
#EL_WS_PORT=8546

# Disk Space Check Overrides
#MOUNT_POINTS=("/" "/mnt/nvme2")
#THRESHOLD=15
#ALERT_FILE="/tmp/mount_alerts.txt"

# Overrides default text editor (nano)
#EDITOR=vim